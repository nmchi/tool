{
  "name": "entity-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:e2e": "node --test --test-isolation=none tests/e2e/*.test.js",
    "backup": "node scripts/backup.mjs",
    "format": "prettier --write src server scripts tests vite.config.ts README.md docs .github pnpm-workspace.yaml",
    "check": "pnpm run build && pnpm test",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "preinstall": "node scripts/check-package-manager.mjs"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "express": "5.1.0",
    "imapflow": "2.10.0",
    "ipaddr.js": "2.2.0",
    "lucide-react": "0.468.0",
    "mailparser": "3.14.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "playwright-core": "1.56.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "packageManager": "pnpm@11.25.0"
}
