# Node.js 24+. pnpm start and pnpm run dev load .env if present.
HOST=127.0.0.1
PORT=4310
ENTITY_DATA_DIR=./data
# Required if binding to a non-loopback interface; minimum 24 characters.
# ENTITY_ACCESS_TOKEN=
# Optional 64-character hexadecimal encryption key. Otherwise data/.vault-key
# is generated with mode 0600. Keep this key when restoring encrypted accounts.
# ENTITY_VAULT_KEY=
# Required public origin when running behind a reverse proxy.
# ENTITY_PUBLIC_ORIGIN=https://entity.example.com
